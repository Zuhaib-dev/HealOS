{
  "name": "@healos/server",
  "version": "1.0.0",
  "private": true,
  "description": "HealOS Backend — Express.js + TypeScript API Server",
  "main": "dist/app.js",
  "scripts": {
    "dev": "tsx watch src/app.ts",
    "build": "tsc",
    "start": "node dist/app.js",
    "lint": "eslint src/ --ext .ts",
    "lint:fix": "eslint src/ --ext .ts --fix",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@healos/shared": "*",
    "express": "^5",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "mongoose": "^8",
    "helmet": "^8",
    "morgan": "^1.10.0",
    "compression": "^1.7.5",
    "express-rate-limit": "^7",
    "http-status-codes": "^2.3.0",
    "zod": "^3.24"
  },
  "devDependencies": {
    "@types/express": "^5",
    "@types/cors": "^2.8.17",
    "@types/morgan": "^1.9.9",
    "@types/compression": "^1.7.5",
    "@types/node": "^22",
    "tsx": "^4",
    "typescript": "^5.7",
    "@typescript-eslint/eslint-plugin": "^8",
    "@typescript-eslint/parser": "^8",
    "eslint": "^9"
  }
}
